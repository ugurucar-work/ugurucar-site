---
interface Props { slides: { src: string; alt: string }[]; pdf: string }
const { slides, pdf } = Astro.props;
---
<div class="deck" data-deck>
  <div class="stage" tabindex="0" aria-roledescription="carousel" aria-label="Creative Ops presentation">
    {slides.map((s, i) => (
      <img src={s.src} alt={s.alt} width="1920" height="1080" class={i === 0 ? 'on' : ''}
        loading={i < 2 ? 'eager' : 'lazy'} decoding="async" data-i={i} />
    ))}
    <button class="nav prev" aria-label="Previous slide" data-prev>‹</button>
    <button class="nav next" aria-label="Next slide" data-next>›</button>
  </div>
  <div class="bar">
    <span class="count"><b data-cur>1</b> / {slides.length}</span>
    <div class="actions">
      <button class="btn ghost sm" data-fs>Full screen</button>
      <a class="btn sm" href={pdf} download>Download PDF</a>
    </div>
  </div>
  <div class="thumbs" role="tablist">
    {slides.map((s, i) => (
      <button role="tab" aria-label={`Slide ${i + 1}`} data-go={i} class={i === 0 ? 'on' : ''}>
        <img src={s.src} alt="" loading="lazy" width="160" height="90" />
      </button>
    ))}
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-deck]').forEach((deck) => {
    const imgs = [...deck.querySelectorAll<HTMLImageElement>('.stage img')];
    const thumbs = [...deck.querySelectorAll<HTMLButtonElement>('[data-go]')];
    const cur = deck.querySelector('[data-cur]')!;
    const stage = deck.querySelector<HTMLElement>('.stage')!;
    let i = 0;
    const go = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((im, k) => im.classList.toggle('on', k === i));
      thumbs.forEach((t, k) => t.classList.toggle('on', k === i));
      const strip = thumbs[i].parentElement!;
      strip.scrollTo({ left: thumbs[i].offsetLeft - strip.clientWidth / 2 + thumbs[i].clientWidth / 2, behavior: 'smooth' });
      cur.textContent = String(i + 1);
      const nxt = imgs[i + 1]; if (nxt) nxt.loading = 'eager';
    };
    deck.querySelector('[data-prev]')!.addEventListener('click', () => go(i - 1));
    deck.querySelector('[data-next]')!.addEventListener('click', () => go(i + 1));
    thumbs.forEach((t) => t.addEventListener('click', () => go(Number(t.dataset.go))));
    stage.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') go(i + 1);
      if (e.key === 'ArrowLeft') go(i - 1);
    });
    let x0: number | null = null;
    stage.addEventListener('touchstart', (e) => { x0 = e.touches[0].clientX; }, { passive: true });
    stage.addEventListener('touchend', (e) => {
      if (x0 === null) return;
      const dx = e.changedTouches[0].clientX - x0;
      if (Math.abs(dx) > 40) go(dx < 0 ? i + 1 : i - 1);
      x0 = null;
    });
    deck.querySelector('[data-fs]')!.addEventListener('click', () => {
      if (document.fullscreenElement) document.exitFullscreen();
      else stage.requestFullscreen?.();
    });
  });
</script>
<style>
  .stage { position: relative; aspect-ratio: 16/9; border-radius: 18px; overflow: hidden; background: #1d1440; border: 1px solid var(--line); outline: none; }
  .stage:focus-visible { box-shadow: 0 0 0 2px var(--accent); }
  .stage:fullscreen { border-radius: 0; border: 0; background: #000; }
  .stage img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; opacity: 0; transition: opacity .25s; }
  .stage img.on { opacity: 1; }
  .nav { position: absolute; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; border-radius: 999px; border: 0; background: rgba(0,0,0,.45); color: #fff; font-size: 28px; line-height: 1; cursor: pointer; display: grid; place-items: center; }
  .nav:hover { background: rgba(0,0,0,.7); }
  .prev { left: 12px; } .next { right: 12px; }
  .bar { display: flex; justify-content: space-between; align-items: center; gap: 12px; margin: 14px 0; flex-wrap: wrap; }
  .count { color: var(--muted); font-size: 14px; }
  .count b { color: var(--fg); }
  .actions { display: flex; gap: 8px; }
  :global(.btn.sm) { padding: 9px 16px; font-size: 14px; cursor: pointer; font-family: inherit; }
  .thumbs { position: relative; display: flex; gap: 8px; overflow-x: auto; padding-bottom: 6px; scrollbar-width: thin; }
  .thumbs button { flex: none; padding: 0; border: 2px solid transparent; border-radius: 8px; overflow: hidden; background: none; cursor: pointer; opacity: .55; }
  .thumbs button.on { border-color: var(--accent); opacity: 1; }
  .thumbs img { width: 120px; height: auto; }
  @media (max-width: 600px) { .nav { width: 36px; height: 36px; font-size: 22px; } .thumbs img { width: 88px; } }
</style>
