---
import '../styles/global.css';
import { SITE, SOCIALS } from '../site';
interface Props { title?: string; description?: string; image?: string; lang?: string; article?: boolean; noindex?: boolean; }
const { title, description = SITE.description, image = '/og/home.jpg', lang = 'en', article = false, noindex = false } = Astro.props;
const fullTitle = title ? `${title} | ${SITE.name}` : SITE.title;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImage = image ? new URL(image, Astro.site).href : undefined;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'Home' },
  { href: '/creative-ops', label: 'AI Work' },
  { href: '/blog', label: 'Blog' },
  { href: '/connect', label: 'Connect' },
];
---
<!doctype html>
<html lang={lang}>
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.ico?v=3" sizes="any" />
  <link rel="icon" href="/favicon.svg?v=3" type="image/svg+xml" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png?v=3" />
  <link rel="manifest" href="/site.webmanifest" />
  <meta name="theme-color" content="#0a0a0b" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={ogImage} />
  {ogImage?.endsWith('/og.jpg') || ogImage?.includes('/og/') ? <><meta property="og:image:width" content="1200" /><meta property="og:image:height" content="630" /></> : null}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Space+Grotesk:wght@500;700&display=swap" rel="stylesheet" />
</head>
<body>
  <header class="site-header">
    <div class="wrap bar">
      <a href="/" class="logo" aria-label="Uğur Uçar, home">
        <svg class="mark" viewBox="0 0 64 64" aria-hidden="true"><defs><linearGradient id="lg" x1="0" y1="0" x2="1" y2="1"><stop offset="0" stop-color="#ff4d4d"/><stop offset="1" stop-color="#7c4dff"/></linearGradient></defs><rect width="64" height="64" rx="16" fill="url(#lg)"/><path d="M18 17v16c0 9.5 5.2 14.5 14 14.5S46 42.5 46 33V17h-7.5v16c0 4.8-2.1 7.4-6.5 7.4s-6.5-2.6-6.5-7.4V17z" fill="#fff"/></svg>
        <span class="wm"><b>Uğur Uçar</b><small>Creative Strategist</small></span>
      </a>
      <nav>
        {nav.map((n) => <a href={n.href} class={(n.href === '/' ? path === '/' : path.startsWith(n.href)) ? 'active' : ''}>{n.label}</a>)}
      </nav>
    </div>
  </header>
  <main><slot /></main>
  <script>
    const io = new IntersectionObserver((es) => es.forEach((e) => {
      if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
    }), { rootMargin: '0px 0px -8% 0px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
  <footer class="site-footer">
    <div class="wrap foot">
      <div class="fl">
        <span>© {new Date().getFullYear()} {SITE.name}</span>
        <a class="fmail" href="mailto:collab@ugurucar.work">collab@ugurucar.work</a>
        <span class="built">Built with AI ✦</span>
      </div>
      <div class="socials">
        {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label}</a>)}
      </div>
    </div>
  </footer>
</body>
</html>
<style>
  .site-header { position: sticky; top: 0; z-index: 10; background: rgba(10,10,11,.75); backdrop-filter: blur(12px); border-bottom: 1px solid var(--line); }
  .bar { display: flex; align-items: center; justify-content: space-between; height: 60px; }
  .logo { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .mark { width: 32px; height: 32px; flex: none; transition: transform .3s cubic-bezier(.2,1.5,.4,1); }
  .logo:hover .mark { transform: rotate(-8deg) scale(1.06); }
  .wm { display: grid; line-height: 1.05; white-space: nowrap; }
  @media (max-width: 560px) { .wm small { display: none; } }
  .wm b { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 17px; letter-spacing: -0.02em; }
  .wm small { font-size: 11px; color: var(--muted); letter-spacing: .04em; }
  nav { display: flex; gap: 18px; }
  @media (max-width: 420px) { nav { gap: 12px; } nav a { font-size: 14px; } .mark { width: 30px; height: 30px; } .wm { display: none; } nav a { white-space: nowrap; } }
  nav a { text-decoration: none; color: var(--muted); font-size: 15px; font-weight: 500; }
  nav a:hover, nav a.active { color: var(--fg); }
  .site-footer { border-top: 1px solid var(--line); margin-top: 96px; padding: 32px 0; color: var(--muted); font-size: 14px; }
  .foot { display: flex; flex-wrap: wrap; gap: 16px; justify-content: space-between; align-items: center; }
  .fl { display: flex; flex-wrap: wrap; gap: 8px 18px; align-items: center; }
  .fmail { color: var(--fg); text-decoration: none; font-weight: 600; }
  .fmail:hover { color: var(--accent); }
  .built { font-size: 12px; border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; background: linear-gradient(90deg, rgba(255,77,77,.12), rgba(124,77,255,.12)); }
  .socials { display: flex; flex-wrap: wrap; gap: 16px; }
  .socials a { text-decoration: none; }
  .socials a:hover { color: var(--fg); }
</style>
