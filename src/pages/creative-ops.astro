<script>
  document.querySelectorAll<HTMLElement>('[data-kit]').forEach((kit) => {
    const tabs = [...kit.querySelectorAll<HTMLButtonElement>('[data-kf]')];
    const groups = [...kit.querySelectorAll<HTMLElement>('[data-kc]')];
    tabs.forEach((b) => b.addEventListener('click', () => {
      const f = b.dataset.kf;
      tabs.forEach((x) => x.classList.toggle('on', x === b));
      kit.classList.toggle('filtered', f !== 'all');
      groups.forEach((g) => {
        const on = f === 'all' || g.dataset.kc === f;
        g.classList.toggle('off', !on);
        if (on) {
          g.querySelectorAll<HTMLElement>('i').forEach((it, n) => {
            it.classList.remove('pop'); void it.offsetWidth;
            it.style.animationDelay = `${n * 45}ms`; it.classList.add('pop');
          });
        }
      });
    }));
  });
  document.querySelectorAll<HTMLButtonElement>('[data-clone]').forEach((b) => b.addEventListener('click', () => {
    const n = b.dataset.clone;
    document.querySelectorAll<HTMLButtonElement>('[data-clone]').forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('[data-clone-panel]').forEach((p) => {
      const on = p.dataset.clonePanel === n; p.hidden = !on;
      p.querySelectorAll('video').forEach((v) => (v as HTMLVideoElement).pause());
      const f = p.querySelector<HTMLIFrameElement>('iframe[data-src]'); if (on && f && !f.src) f.src = f.dataset.src!;
    });
  }));
  const vids = document.querySelectorAll<HTMLVideoElement>('video.auto');
  const io = new IntersectionObserver((es) => es.forEach((e) => {
    const v = e.target as HTMLVideoElement;
    if (e.isIntersecting) { v.preload = 'auto'; v.play().catch(() => {}); } else v.pause();
  }), { threshold: .35 });
  vids.forEach((v) => {
    io.observe(v);
    v.addEventListener('click', () => {
      const on = v.muted;
      vids.forEach((o) => { o.muted = true; });
      v.muted = !on; if (!v.muted) { v.currentTime = 0; v.play().catch(() => {}); }
      vids.forEach((o) => o.parentElement?.classList.toggle('sound', !o.muted));
    });
  });
</script>

