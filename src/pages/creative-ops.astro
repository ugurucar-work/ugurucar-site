---
import Base from '../layouts/Base.astro';
import { SHOWCASE } from '../data/showcase';
const aiWork = SHOWCASE.filter((s) => s.group === 'best');
const clones = SHOWCASE.filter((s) => s.group === 'clone' && (s.reference || s.referenceImage));
const kit = SHOWCASE.filter((s) => s.group === 'adkit' && s.type === 'video').slice(0, 4);
const statics = SHOWCASE.filter((s) => s.group === 'adkit' && s.type === 'image' && s.ratio !== '1:1').slice(0, 4);
const kinStills = SHOWCASE.filter((s) => s.group === 'kinetic-still').slice(0, 4);
const explainers = SHOWCASE.filter((s) => s.group === 'explainer').slice(0, 3);
const variations = SHOWCASE.filter((s) => s.group === 'variation').slice(0, 3);
const hooks = SHOWCASE.filter((s) => s.group === 'hook');
const films = SHOWCASE.filter((s) => s.group === 'film').slice(0, 3);
const avatars = SHOWCASE.filter((s) => s.group === 'avatar');
const imgVars = [
  { h: 'from $0.01', b: ['200+ destinations', 'Landlines and mobiles', 'Rate shown first', 'Works on WiFi'], c: 'Start With $0.25 Credit', light: true, win: true },
  { list: ['200+ destinations', 'Landlines and mobiles', 'Rate shown before you dial', 'Works on WiFi'], c: 'Start With $0.25 Credit' },
  { h: 'from $0.01', phone: true, c: 'Start With $0.25 Credit' },
  { h: 'No SIM needed', b: ['Works on WiFi', 'Ready in 60 seconds', 'No new SIM card', 'Keep your number'], c: 'Get $0.25 Free Credit' },
  { h: 'No surprise bill', b: ['Rate shown first', 'No contract', 'No monthly plan', 'Pay as you use'], c: 'Get $0.25 Free Credit' },
  { h: 'Clear on both ends', b: ['HD voice quality', 'Landlines and mobiles', 'Works on WiFi', '200+ destinations'], c: 'Get $0.25 Free Credit' },
  { h: 'Your number stays private', b: ['A separate number', '+44 UK number', 'Real number hidden', 'Cancel anytime'], c: 'Get Your Second Number' },
  { h: 'Call home tonight', b: ['200+ destinations', 'Landlines and mobiles', 'Works on WiFi', 'Calls from $0.01'], c: 'Get $0.25 Free Credit' },
  { h: 'from $0.01', hand: true, c: 'Start With $0.25 Credit' },
  { diag: 'from $0.01', c: 'Start With $0.25 Credit' },
];
const ttId = (u?: string) => u?.match(/tiktok\.com\/.*video\/(\d+)/)?.[1];

const pains = [
  { t: 'Scattered research', d: 'Competitor ads, trends and organic hits lived in ten different tabs.' },
  { t: 'Manual production', d: 'Every variation was a ticket, a brief and a wait.' },
  { t: 'Uneven test reading', d: 'A different window, a different lens and a different conclusion every week.' },
  { t: 'Stalled winners', d: 'Good ads were found, then never scaled or iterated in time.' },
];
const glance = [
  { t: 'Research', i: ['Daily competitor ad tracking', 'Weekly market report analysis', 'Trend and organic post scans'] },
  { t: 'Production', i: ['Any ad adapted from a link', 'Avatar, kinetic and story videos', 'Edit requests with versions'] },
  { t: 'Ad kits', i: ['One concept to a full test set', 'A different hook per piece', 'Fact check and final QC'] },
  { t: 'Testing', i: ['Weekly winner detection', 'Variations of every winner', 'The weekly test report'] },
  { t: 'Performance', i: ['Live view across platforms', 'Fatigue and unscaled winners', 'Hooked but weak, and variate lists'] },
  { t: 'Creators & launch', i: ['TikTok One briefs and videos', 'Influencer search and AI outreach', 'Naming, sizing and upload'] },
];
const loop = ['Research', 'Produce', 'Test', 'Read', 'Scale'];
const rivals = [
  { n: 'TextNow', c: '#7b2ff7', a: 87, d: 187, s: [3, 5, 4, 7, 9, 12, 14] },
  { n: 'Roamless', c: '#0ea5e9', a: 222, d: 119, s: [8, 9, 11, 10, 12, 13, 15] },
  { n: 'Rakuten Viber', c: '#7360f2', a: 157, d: 71, s: [6, 6, 7, 9, 8, 10, 11] },
  { n: 'Yolla', c: '#f59e0b', a: 30, d: 73, s: [2, 3, 3, 6, 8, 9, 13] },
  { n: 'Rebtel', c: '#e11d48', a: 64, d: 69, s: [5, 4, 6, 6, 7, 8, 9] },
  { n: 'Talk360', c: '#10b981', a: 10, d: 44, s: [1, 2, 2, 4, 5, 7, 9] },
];
const feed = [
  { k: 'need', t: 'Feedback needed · high', d: 'Image 14 still shows last month\'s promo. Remove it from future tests?', a: ['Remove', 'Keep'] },
  { k: 'need', t: 'Feedback needed', d: 'Avatar clip 3 says the brand name with a strong accent. Add a logo pop at 0:04?', a: ['Yes, add it', 'Skip'] },
  { k: 'done', t: 'Creator brief ready', d: '"The two tap setup, shown on camera"', m: 'Fri 16:30' },
  { k: 'done', t: 'Rule added to skill', d: '"No script fonts next to the logo"', m: 'Thu 11:05' },
  { k: 'done', t: 'edit_video', d: 'Edit 2 · 0 credits', m: 'Tue 15:22' },
];
const runSteps = [
  ['Find the winners', 'done'], ['Cut new hooks onto winning videos', 'done'], ['Vary the winning images', 'done'],
  ['Avatar clips for the winning angle', 'run'], ['AI video variations', 'q'], ['Visual scroll-stopper hooks', 'q'],
  ['Kinetic text ads', 'q'], ['Facts and brand check', 'q'], ['Report to Slack and dashboard', 'q'],
];
const tools = ['Claude Code', 'Higgsfield', 'Arcads', 'Latted', 'Meta Ads', 'TikTok Ads', 'Adjust', 'Additor', 'SensorTower', 'Spiral.ad', 'Google Drive', 'Slack', 'Design system', 'Local render stack'];
const guards = [
  { t: 'Approval before spend', d: 'Every paid generation shows its plan and cost first. Budgets have hard limits.' },
  { t: 'One source of facts', d: 'Prices and claims come from one fact sheet. A lint blocks anything else.' },
  { t: 'Read only on ad accounts', d: 'The system reads campaigns. Changes happen only in the launch layer, with approval.' },
  { t: 'One design system', d: 'Official logo, end cards and colors. The AI never redraws the brand.' },
  { t: 'Quality check last', d: 'Every video and image is reviewed before it is marked done.' },
  { t: 'Feedback that sticks', d: 'Notes become rules for the next run and are written into the skills.' },
];
const results = [
  { n: 'Same day', l: 'from concept to a launch-ready ad set, instead of days' },
  { n: '10x+', l: 'more creatives tested every week' },
  { n: '3x+', l: 'more winners found, scaled in days not weeks' },
  { n: '10,000+', l: 'AI creatives produced so far' },
];
---
<Base title="AI Creative Machine" description="The AI creative system I built: it researches, produces, tests and scales ads every week, while I steer strategy and spend." image="/images/blog/the-ai-creative-machine/cover.jpg">

  <!-- HERO -->
  <section class="hero">
    <div class="glowv" aria-hidden="true"></div>
    <div class="wrap hgrid">
      <div>
        <p class="eyebrow">AI Creative Machine</p>
        <h1 class="display">I built a machine that makes and tests ads. <span class="grad-text">Every week.</span></h1>
        <p class="lead">A creative system I designed and run, built on AI skills and real performance data. One concept goes in, a launch-ready ad set comes out, and last week's winners become this week's tests. AI does the work. I steer.</p>
        <div class="ctas">
          <a class="btn" href="#how">See how it works</a>
          <a class="btn ghost" href="mailto:collab@ugurucar.work">collab@ugurucar.work</a>
        </div>
      </div>
      <div class="slot hero-slot" data-slot="hero-example">
        <div class="kit" data-kit>
          <div class="kh"><b>Ad Kit · Concept A</b><span class="ok">Delivered</span></div>
          <div class="ktabs" role="group" aria-label="Filter ad kit">
            {[['all','All',18],['v','Avatars',6],['k','Kinetic',3],['f','Films',3],['i','Images',6]].map(([k,l,n], i) => (
              <button type="button" class={i === 0 ? 'on' : ''} data-kf={k}>{l} {n}</button>
            ))}
          </div>
          <div class="kbody" aria-hidden="true">
            <div class="krow" data-kc="v">{['lily','vincent','ashley','albert','hook-sim','hook-jelly'].map((n) => <i class="ph v img" style={`background-image:url(/images/previews/${n}.webp)`}></i>)}</div>
            <div class="krow two">
              <div data-kc="k">{['kin-explainer-private-number.jpg','kin-explainer-calls.jpg','kin-explainer-work-line.jpg'].map((n) => <i class="ph k img" style={`background-image:url(/work/telicall/${n})`}></i>)}</div>
              <div data-kc="f">{['film-mexico-city-1998','film-quiet-grew','film-fake-number'].map((n) => <i class="ph f img" style={`background-image:url(/work/telicall/${n}.jpg)`}></i>)}</div>
            </div>
            <div class="krow" data-kc="i">{['sq-creator-kit-lagos','sq-neon-go-global','sq-comic-went-global','sq-honest-table','sq-lagos-to-london','static-tiny-rates'].map((n) => <i class="sq img" style={`background-image:url(/work/telicall/${n}.webp)`}></i>)}</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROBLEM -->
  <section class="wrap block">
    <div class="head reveal">
      <p class="eyebrow">The problem</p>
      <h2 class="display sec">Why I built it: creative is the lever, the work around it was the bottleneck.</h2>
    </div>
    <div class="g4">
      {pains.map((p, i) => <article class="card reveal" style={`transition-delay:${i * 80}ms`}><span class="x">✕</span><h3>{p.t}</h3><p>{p.d}</p></article>)}
    </div>
  </section>

  <!-- AT A GLANCE -->
  <section class="wrap block">
    <div class="head reveal">
      <p class="eyebrow">What the machine runs</p>
      <h2 class="display sec">Six jobs, handled every week</h2>
    </div>
    <div class="g3">
      {glance.map((g, i) => (
        <article class={`card glance reveal ${i === 5 ? 'hot' : ''}`} style={`transition-delay:${i * 60}ms`}>
          <h3>{g.t}</h3>
          <ul>{g.i.map((x) => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <!-- LOOP -->
  <section class="band" id="how">
    <div class="wrap">
      <div class="head reveal center">
        <p class="eyebrow">How it works</p>
        <h2 class="display sec">One loop. Run every Monday.</h2>
        <p class="sub">Every Monday the loop starts again from what last week's tests taught me. I approve plans and spend. AI does the searching, writing, editing and reading.</p>
      </div>
      <ol class="loop reveal">
        {loop.map((s, i) => <li><span>{i + 1}</span>{s}</li>)}
      </ol>
    </div>
  </section>

  <!-- FEATURE: RESEARCH -->
  <section class="wrap feat reveal">
    <div class="ftext">
      <p class="eyebrow">01 · Research</p>
      <h2 class="display">Briefs start from what already works</h2>
      <p>My research no longer starts from a blank page. Ads, trends and organic hits are collected automatically, so every brief is built on evidence.</p>
      <ul class="ticks">
        <li><b>Explore</b> TikTok trends, YouTube, Google Ads and live Meta ad search in one place.</li>
        <li><b>Competitor intel</b> Competitor videos pulled automatically from SensorTower and Spiral.ad, widest-reach ads checked every morning.</li>
        <li><b>Image ads</b> Last week's competitor image ads, pulled and analyzed.</li>
        <li><b>Trending</b> Organic TikTok, Instagram and X posts ranked by how fast they grow.</li>
      </ul>
    </div>
    <div class="slot" data-slot="research-example" aria-hidden="true">
      <div class="mock intel">
        <div class="mh"><div><small>Tracked competitors · Meta</small><b>Competitor Intel</b></div><span class="live">● Checked 07:00</span></div>
        <div class="ihead"><span>Competitor</span><span>Active ads</span><span>New · 7d</span><span>Trend</span></div>
        {rivals.map((r) => {
          const max = Math.max(...r.s);
          return (
            <div class="irow">
              <span class="who"><i style={`background:${r.c}`}>{r.n[0]}</i><span class="nm">{r.n}</span></span>
              <b>{r.a}</b>
              <em>+{r.d}</em>
              <span class="spark">{r.s.map((v) => <i style={`height:${(v / max) * 100}%;background:${r.c}`}></i>)}</span>
            </div>
          );
        })}
        <div class="ifoot"><span>Top reach today</span><div>{[0,1,2,3,4].map((n) => <i class={`thumb t${n % 4}`}></i>)}</div></div>
      </div>
    </div>
  </section>

  <!-- FEATURE: PRODUCTION -->
  <section class="wrap feat flip reveal">
    <div class="ftext">
      <p class="eyebrow">02 · Production</p>
      <h2 class="display">From a link to a finished ad</h2>
      <p>I paste any ad I like. It comes back rebuilt for the brand, with its design system and end card, tracked end to end.</p>
      <div class="pipe"><span>Queued</span><span>In production</span><span>Delivered</span><span class="on">Uploaded</span></div>
      <ul class="ticks">
        <li><b>Edit requests</b> Write what should change. Every version stays: Original, Edit 1, Edit 2.</li>
        <li><b>Credit permission</b> Free edit tools first. AI credits only when approved, up to a cap.</li>
      </ul>
    </div>
    {clones.length > 0 ? (
      <div class="slot clonewrap">
        {clones.length > 1 && (
          <div class="ctabs" role="tablist">
            {clones.map((c, i) => <button role="tab" class={i === 0 ? 'on' : ''} data-clone={i}>Example {i + 1} · {c.format}</button>)}
          </div>
        )}
        {clones.map((c, i) => (
          <div class="clone" data-clone-panel={i} hidden={i !== 0}>
            <div class="cl">
              <span class="lbl">Reference</span>
              <div class="frame">
                {ttId(c.reference)
                  ? <iframe data-src={`https://www.tiktok.com/player/v1/${ttId(c.reference)}?music_info=0&description=0&rel=0`} src={i === 0 ? `https://www.tiktok.com/player/v1/${ttId(c.reference)}?music_info=0&description=0&rel=0` : undefined} title="Reference ad" loading="lazy" allow="encrypted-media; fullscreen" allowfullscreen></iframe>
                  : <img src={c.referenceImage} alt={c.referenceLabel ?? 'Reference ad'} loading="lazy" />}
              </div>
              {c.reference
                ? <a class="src" href={c.reference} target="_blank" rel="noopener">{c.referenceLabel ?? 'Reference'} ↗</a>
                : <span class="src">{c.referenceLabel ?? 'Reference'}</span>}
            </div>
            <div class="arrow" aria-hidden="true">→</div>
            <div class="cl">
              <span class="lbl">Rebuilt for {c.app}</span>
              <div class="frame out"><video src={c.src} poster={c.poster} controls playsinline preload="metadata"></video></div>
              <span class="src">{c.format} · brand end card</span>
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="slot" data-slot="production-example" aria-hidden="true">
        <div class="ba">
          <div><span class="lbl">Reference</span><i class="ph big ref"></i></div>
          <div class="arrow">→</div>
          <div><span class="lbl">On brand</span><i class="ph big out"></i></div>
        </div>
      </div>
    )}
  </section>

  <!-- FEATURE: AD KIT -->
  <section class="wrap feat reveal">
    <div class="ftext">
      <p class="eyebrow">03 · Ad Kit</p>
      <h2 class="display">One prompt in. A complete ad set out.</h2>
      <p>I type one concept. The kit comes back as a launch-ready test set behind a single approval. Every piece gets a different hook mechanic, every claim is checked, and a final quality check runs before it is marked done.</p>
      <div class="fmt">
        <div><b>Avatar clips</b><span>AI presenters, each script with its own hook, captions and app proof.</span></div>
        <div><b>Kinetic ads</b><span>Animated typography with real app screens, rendered at no credit cost.</span></div>
        <div><b>Story films</b><span>Short, mid and long narrative films with dialogue and end card.</span></div>
        <div><b>Static images</b><span>Several layouts, each checked for on-image text errors.</span></div>
      </div>
    </div>
    {kit.length > 0 ? (
      <div class="slot kitreal">
        <div class="kgrid">
          {kit.map((k) => (
            <figure>
              <video class="auto" src={k.src} poster={k.poster} muted loop playsinline preload="none"></video>
              <figcaption><b>{k.format}</b>{k.title}</figcaption>
            </figure>
          ))}
        </div>
        {explainers.length > 0 && (
          <div class="kgrid three">
            {explainers.map((k) => (
              <figure>
                <video class="auto" src={k.src} poster={k.poster} muted loop playsinline preload="none"></video>
                <figcaption><b>Kinetic</b>{k.title}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {kinStills.length > 0 && (
          <div class="sgrid">{kinStills.map((s) => <figure><img src={s.src} alt={s.title} loading="lazy" /><figcaption><b>Kinetic</b>{s.title}</figcaption></figure>)}</div>
        )}
        {films.length > 0 && (
          <div class="kgrid three">
            {films.map((k) => (
              <figure>
                <video class="auto" src={k.src} poster={k.poster} muted loop playsinline preload="none"></video>
                <figcaption><b>Story film</b>{k.title}</figcaption>
              </figure>
            ))}
          </div>
        )}
        {statics.length > 0 && (
          <div class="sgrid">{statics.map((s) => <figure><img src={s.src} alt={s.title} loading="lazy" /><figcaption><b>Static</b>{s.title}</figcaption></figure>)}</div>
        )}
        <p class="knote">Pieces from Telicall ad kits: avatar, kinetic, story film and static. Tap a video to hear.</p>
      </div>
    ) : (
      <div class="slot" data-slot="adkit-example" aria-hidden="true">
        <div class="fan">{[0,1,2,3].map((n) => <i class={`ph fan${n}`}></i>)}</div>
      </div>
    )}
  </section>

  {avatars.length > 0 && (
    <section class="wrap varis reveal">
      <div class="vhead">
        <p class="eyebrow">Avatar clips</p>
        <h3 class="display">Many faces. One proven script.</h3>
        <p>AI presenters let one angle be tested across ages, accents and settings in a day. Each clip gets its own hook and captions, with app proof cut in.</p>
      </div>
      <div class="hgrid4 six">
        {avatars.map((h) => (
          <figure>
            <video class="auto" src={h.src} poster={h.poster} muted loop playsinline preload="none"></video>
            <figcaption>{h.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <!-- FEATURE: MONDAY RUN -->
  <section class="wrap feat flip reveal">
    <div class="ftext">
      <p class="eyebrow">04 · Creative testing</p>
      <h2 class="display">The Monday run: last week's winners become this week's tests</h2>
      <p>One orchestrated run, one skill per step. It finds the winners by sales and cost per install, then builds the next round around them, inside a credit budget with a hard limit.</p>
    </div>
    <div class="slot" data-slot="monday-example" aria-hidden="true">
      <div class="mock">
        <div class="mh"><b>Monday run</b><span>9 steps</span></div>
        {runSteps.map(([t, s], i) => (
          <div class="step"><span class="num">{i + 1}</span><b>{t}</b><em class={s}>{s === 'done' ? 'Done' : s === 'run' ? 'Running' : 'Queued'}</em></div>
        ))}
      </div>
    </div>
  </section>

  {variations.length > 0 && (
    <section class="wrap varis reveal">
      <div class="vhead">
        <p class="eyebrow">Winner variations</p>
        <h3 class="display">Same winning edit. New hook, new presenter, new world.</h3>
        <p>When a video wins, the run rebuilds it with a new visual hook, presenter and scene while keeping the proven script and app walkthrough. One winner becomes a family of tests.</p>
      </div>
      <div class="vgrid">
        {variations.map((v, i) => (
          <figure>
            <video class="auto" src={v.src} poster={v.poster} muted loop playsinline preload="none"></video>
            <figcaption>Variation {String.fromCharCode(65 + i)}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  {hooks.length > 0 && (
    <section class="wrap varis reveal">
      <div class="vhead">
        <p class="eyebrow">Best performing hooks</p>
        <h3 class="display">Three seconds to stop the scroll.</h3>
        <p>Short, oddly satisfying AI openers cut onto proven bodies. Same ad, new first three seconds, and a fatigued winner gets a second life.</p>
      </div>
      <div class="hgrid4">
        {hooks.map((h) => (
          <figure>
            <video class="auto" src={h.src} poster={h.poster} muted loop playsinline preload="none"></video>
            <figcaption>{h.title}</figcaption>
          </figure>
        ))}
      </div>
    </section>
  )}

  <section class="wrap varis reveal">
    <div class="vhead">
      <p class="eyebrow">Variation engine · statics</p>
      <h3 class="display">One winning image. Ten new tests.</h3>
      <p>The run takes a winning static and changes one thing at a time: the headline angle, the proof points, the layout or the visual. Same brand system, same offer, ten clean reads on what moves the number.</p>
    </div>
    <div class="ivgrid" aria-hidden="true">
      {imgVars.map((v, i) => (
        <div class={`iv ${v.light ? 'light' : ''} ${v.win ? 'win' : ''}`}>
          {v.win && <span class="wtag">Winner</span>}
          {!v.win && <span class="vtag">V{i}</span>}
          {!v.list && !v.diag && <b class="brand">Telicall</b>}
          {v.list && <ul class="vlist">{v.list.map((x) => <li>✓ {x}</li>)}</ul>}
          {v.list && <span class="mini">from $0.01</span>}
          {v.h && <span class={`pill ${v.h.length > 14 ? 'long' : ''}`}>{v.h}</span>}
          {v.phone && <i class="vphone"></i>}
          {v.hand && <i class="vphone tilt"></i>}
          {v.diag && <><b class="brand top">Telicall</b><span class="vband">{v.diag}</span></>}
          {v.b && <div class="vb">{v.b.map((x) => <span>● {x}</span>)}</div>}
          <span class={`cta ${v.diag ? 'bottom' : ''}`}>{v.c}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- FEATURE: FEEDBACK -->
  <section class="wrap feat reveal">
    <div class="ftext">
      <p class="eyebrow">05 · Feedback loop</p>
      <h2 class="display">Every note becomes a rule</h2>
      <p>When the machine is unsure, a question lands in the dashboard like a social feed. I answer or leave a note, the AI fixes the output, and the note is written into the skill so every next run follows it.</p>
      <div class="two">
        <div><b class="good">Fixed for good</b><span>Wrong fonts, prices outside the rules, kits missing pieces, films without captions.</span></div>
        <div><b class="eye">Still needs an eye</b><span>AI faces drifting, garbled screen text, bold claims. Taste stays human.</span></div>
      </div>
    </div>
    <div class="slot" data-slot="feedback-example" aria-hidden="true">
      <div class="mock notif">
        <div class="mh"><b>Notifications</b><span class="bell">🔔<i>2</i></span></div>
        {feed.map((f) => (
          <div class={`nf ${f.k}`}>
            <span class="dot"></span>
            <div>
              <b>{f.t}</b>
              <p>{f.d}</p>
              {f.a ? <div class="acts">{f.a.map((x, i) => <em class={i === 0 ? 'p' : ''}>{x}</em>)}</div> : <small>{f.m}</small>}
            </div>
            {f.k === 'done' && <span class="close">✕</span>}
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- FEATURE: PERFORMANCE -->
  <section class="wrap feat flip reveal">
    <div class="ftext">
      <p class="eyebrow">06 · Performance</p>
      <h2 class="display">Four lists. Each with a reason and a next step.</h2>
