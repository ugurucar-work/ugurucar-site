---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { PROJECTS, EXPERIENCE } from '../site';
const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const latest = posts.slice(0, 3);
const words = [
  'scroll-stopping', 'UGC', 'thumb-stopping', 'creator-led', 'AI-powered', 'hook-first',
  'unskippable', 'TikTok-native', 'test-winning', 'avatar', 'kinetic', 'story-driven',
  'meme-worthy', 'data-backed', 'high-converting', 'Reels-ready', 'weirdly good',
  'binge-worthy', 'native-feeling', 'globally-scaled', 'shamelessly honest', 'loud', 'tiny-budget',
];
const stats = [
  { n: '1000+', l: 'content creators collaborated with' },
  { n: `${PROJECTS.length}`, l: 'apps grown with creative' },
  { n: '1', l: 'AI creative loop, run every week' },
  { n: `${posts.length}`, l: 'articles on marketing' },
];
const tools = ['Claude Code', 'Arcads', 'Higgsfield', 'n8n', 'Meta Ads', 'TikTok One', 'SensorTower', 'Additor'];
---
<Base>
  <section class="hero">
    <div class="blobs" aria-hidden="true"><span></span><span></span><span></span></div>
    <div class="wrap">
      <p class="eyebrow">Uğur Uçar · Full-stack Creative</p>
      <h1 class="display">
        I make
        <button class="word" type="button" data-words={JSON.stringify(words)} aria-live="polite" aria-label="Change the word">
          <span class="grad-text" data-word>{words[0]}</span>
        </button>
        <br />ads that perform.
      </h1>
      <p class="hint" aria-hidden="true">↑ tap the word</p>
      <p class="lead">I partner with creators and run AI pipelines that research, produce, test and scale ads — every single week.</p>
      <div class="ctas">
        <a class="btn" href="/creative-ops">See the machine →</a>
        <a class="btn ghost" href="/portfolio">Portfolio</a>
        <a class="btn ghost" href="mailto:collab@ugurucar.work">collab@ugurucar.work</a>
      </div>
    </div>
  </section>

  <section class="marquee" aria-label="Apps I've worked on">
    <div class="track">
      {[0, 1].map((k) => (
        <div class="row" aria-hidden={k === 1 ? 'true' : undefined}>
          {PROJECTS.map((p) => (
            <span class="chip"><img src={p.logo} alt="" width="28" height="28" loading="lazy" />{p.name}</span>
          ))}
        </div>
      ))}
    </div>
  </section>

  <section class="wrap stats">
    {stats.map((s) => (
      <div class="stat reveal"><span class="display n">{s.n}</span><span class="l">{s.l}</span></div>
    ))}
  </section>

  <section class="wrap feature reveal">
    <a href="/creative-ops" class="fcard">
      <div class="ftext">
        <p class="eyebrow">Case study</p>
        <h2 class="display">The AI Creative Machine</h2>
        <p>One concept in, a complete ad set out. Research, production, testing and scaling — run by AI, steered by me.</p>
        <span class="more">Open the deck →</span>
      </div>
      <img src="/creative-ops/slide-01.webp" alt="The AI Creative Machine deck cover" width="1920" height="1080" loading="lazy" />
    </a>
  </section>

  <section class="wrap what">
    <h2 class="display sec reveal">What I do</h2>
    <div class="grid4">
      {EXPERIENCE.map((e, i) => (
        <article class="reveal" style={`transition-delay:${i * 80}ms`}>
          <span class="idx">0{i + 1}</span>
          <h3>{e.title}</h3>
          <p>{e.text}</p>
        </article>
      ))}
    </div>
    <div class="tools reveal">
      <span class="eyebrow">Stack</span>
      {tools.map((t) => <span class="tool">{t}</span>)}
    </div>
  </section>

  <section class="wrap latest">
    <div class="head reveal"><h2 class="display sec">Writing</h2><a href="/blog">All posts →</a></div>
    <div class="grid3">{latest.map((p) => <div class="reveal"><PostCard post={p} /></div>)}</div>
  </section>

  <section class="wrap end reveal">
    <h2 class="display">Let's make something<br /><span class="grad-text">that performs.</span></h2>
    <a class="btn" href="mailto:collab@ugurucar.work">collab@ugurucar.work</a>
  </section>
</Base>
<script>
  const btn = document.querySelector<HTMLButtonElement>('.word');
  if (btn) {
    const words: string[] = JSON.parse(btn.dataset.words || '[]');
    const label = btn.querySelector<HTMLElement>('[data-word]')!;
    const hint = document.querySelector<HTMLElement>('.hint');
    const colors = ['#ff4d4d', '#ff8a5c', '#7c4dff', '#ffd166', '#f4f4f5'];
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let i = 0, timer: number | undefined, touched = false;
    const show = (n: number) => {
      i = (n + words.length) % words.length;
      label.textContent = words[i];
      btn.classList.remove('pop'); void btn.offsetWidth; btn.classList.add('pop');
    };
    const burst = (x: number, y: number) => {
      if (reduce) return;
      for (let k = 0; k < 18; k++) {
        const s = document.createElement('span');
        s.className = 'spark';
        s.style.left = x + 'px'; s.style.top = y + 'px';
        s.style.background = colors[k % colors.length];
        document.body.appendChild(s);
        const a = (Math.PI * 2 * k) / 18 + Math.random() * .4;
        const d = 50 + Math.random() * 70;
        s.animate([
          { transform: 'translate(-50%,-50%) scale(1) rotate(0deg)', opacity: 1 },
          { transform: `translate(calc(-50% + ${Math.cos(a) * d}px), calc(-50% + ${Math.sin(a) * d}px)) scale(.3) rotate(${Math.random() * 360}deg)`, opacity: 0 },
        ], { duration: 650 + Math.random() * 250, easing: 'cubic-bezier(.2,.8,.3,1)' }).onfinish = () => s.remove();
      }
    };
    const auto = () => { timer = window.setInterval(() => show(i + 1), 2200); };
    btn.addEventListener('click', (e) => {
      clearInterval(timer);
      let n = i; while (n === i && words.length > 1) n = Math.floor(Math.random() * words.length);
      show(n);
      const r = label.getBoundingClientRect();
      burst(e.clientX || r.left + r.width / 2, e.clientY || r.top + r.height / 2);
      if (!touched && hint) { touched = true; hint.style.visibility = 'hidden'; }
      window.setTimeout(auto, 6000);
    });
    if (!reduce) auto();
  }
</script>
<style>
  .hero { position: relative; isolation: isolate; padding: 110px 0 90px; overflow: hidden; }
  .blobs { position: absolute; inset: 0; z-index: -1; filter: blur(70px); opacity: .55; }
  .blobs span { position: absolute; border-radius: 50%; animation: float 18s ease-in-out infinite alternate; }
  .blobs span:nth-child(1) { width: 520px; height: 520px; background: var(--accent); top: -180px; right: -120px; }
  .blobs span:nth-child(2) { width: 460px; height: 460px; background: var(--violet); bottom: -220px; left: -120px; animation-duration: 22s; }
  .blobs span:nth-child(3) { width: 300px; height: 300px; background: #ff8a5c; top: 30%; left: 45%; opacity: .5; animation-duration: 26s; }
  @keyframes float { to { transform: translate(-60px, 50px) scale(1.15); } }
  h1 { font-size: clamp(42px, 8.4vw, 104px); margin: 18px 0 26px; }
  .word { font: inherit; letter-spacing: inherit; color: inherit; background: none; border: 0; padding: 0; margin: 0; cursor: pointer; position: relative; display: inline-block; text-align: left; -webkit-tap-highlight-color: transparent; }
  .word span { display: inline-block; padding-bottom: .06em; border-bottom: 3px dashed rgba(255,255,255,.18); transition: border-color .2s; }
  .word:hover span { border-color: rgba(255,255,255,.45); }
  .word:focus-visible { outline: 2px solid var(--accent); outline-offset: 6px; border-radius: 8px; }
  .word.pop span { animation: pop .42s cubic-bezier(.2,1.6,.4,1); }
  @keyframes pop { 0% { transform: scale(.7) rotate(-4deg); opacity: 0; filter: blur(6px); } 100% { transform: none; opacity: 1; filter: none; } }
  .hint { margin: -12px 0 18px; font-size: 13px; color: var(--muted); letter-spacing: .04em; animation: nudge 2.4s ease-in-out infinite; }
  @keyframes nudge { 50% { transform: translateY(-3px); opacity: .6; } }
  :global(.spark) { position: fixed; z-index: 50; width: 8px; height: 8px; border-radius: 2px; pointer-events: none; }
  .lead { max-width: 560px; font-size: 19px; color: #c8c8cf; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 34px; }

  .marquee { border-block: 1px solid var(--line); padding: 18px 0; overflow: hidden; mask-image: linear-gradient(90deg, transparent, #000 10%, #000 90%, transparent); }
  .track { display: flex; width: max-content; animation: slide 30s linear infinite; }
  .marquee:hover .track { animation-play-state: paused; }
  .row { display: flex; gap: 40px; padding-right: 40px; }
  .chip { display: inline-flex; align-items: center; gap: 10px; font-weight: 600; white-space: nowrap; color: #d4d4d8; }
  .chip img { border-radius: 7px; }
  @keyframes slide { to { transform: translateX(-50%); } }

  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; padding-top: 72px; padding-bottom: 24px; }
  .stat { border-left: 1px solid var(--line); padding-left: 18px; }
  .n { display: block; font-size: clamp(40px, 6vw, 68px); }
  .l { color: var(--muted); font-size: 14px; }

  .feature { padding-top: 64px; }
  .fcard { display: grid; grid-template-columns: 1fr 1.25fr; gap: 32px; align-items: center; text-decoration: none; padding: 28px; border-radius: 24px; border: 1px solid #2c2350;
    background: radial-gradient(120% 120% at 0% 0%, rgba(124,77,255,.28), transparent 55%), var(--bg-2); transition: border-color .3s, transform .3s; }
  .fcard:hover { border-color: var(--violet); transform: translateY(-3px); }
  .fcard h2 { font-size: clamp(32px, 4.4vw, 52px); margin: 8px 0 14px; }
  .fcard p { color: var(--muted); margin: 0 0 18px; }
  .fcard img { border-radius: 14px; box-shadow: 0 30px 60px -20px rgba(124,77,255,.45); }
  .more { font-weight: 600; color: #b9a3ff; }

  .what, .latest { padding-top: 96px; }
  .sec { font-size: clamp(36px, 6vw, 64px); margin: 0 0 28px; }
  .grid4 { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 18px; }
  .grid4 article { background: var(--bg-2); border: 1px solid var(--line); border-radius: 18px; padding: 24px; }
  .idx { font-family: 'Space Grotesk', sans-serif; color: var(--accent); font-weight: 700; }
  .grid4 h3 { margin: 8px 0; font-size: 19px; }
  .grid4 p { margin: 0; color: var(--muted); font-size: 15px; }
  .tools { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; margin-top: 22px; }
  .tools .eyebrow { margin-right: 6px; }
  .tool { border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px; font-size: 14px; color: #d4d4d8; }
  .head { display: flex; justify-content: space-between; align-items: baseline; }
  .head a { color: var(--muted); text-decoration: none; }
  .grid3 { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 28px; }

  .end { text-align: center; padding-top: 120px; }
  .end h2 { font-size: clamp(40px, 7vw, 88px); margin: 0 0 32px; }

  @media (max-width: 760px) {
    .stats { grid-template-columns: 1fr 1fr; row-gap: 28px; }
    .fcard { grid-template-columns: 1fr; padding: 20px; }
    .fcard img { order: -1; }
    .hero { padding: 80px 0 64px; }
  }
</style>
