---
import Base from '../layouts/Base.astro';
import { SOCIALS } from '../site';
---
<Base title="Connect" image="/og/connect.jpg" description="Get in touch with Uğur Uçar about paid UA, creative strategy and AI-driven creative.">
  <section class="hero">
    <div class="glow" aria-hidden="true"></div>
    <div class="wrap grid">
      <div class="photo reveal">
        <img src="/images/ugur.webp" alt="Uğur Uçar" width="500" height="506" />
      </div>
      <div class="copy">
        <p class="eyebrow">Connect</p>
        <h1 class="display">Let's talk.</h1>
        <p class="lead">I'm Uğur, a creative strategist working across paid UA, UGC and AI creative production for consumer apps. If you want to talk creative, collaborate on a project or swap notes on what's working in ads right now, I'd love to hear from you.</p>
        <a class="mail" href="mailto:collab@ugurucar.work">collab@ugurucar.work <span>↗</span></a>
        <div class="links">
          {SOCIALS.map((s) => <a href={s.href} target="_blank" rel="noopener">{s.label} <span>↗</span></a>)}
        </div>
        <p class="note">Usually replies within a day or two.</p>
      </div>
    </div>
  </section>
</Base>
<style>
  .hero { position: relative; isolation: isolate; padding: 90px 0 40px; }
  .grid { display: grid; grid-template-columns: .85fr 1.15fr; gap: 56px; align-items: center; }
  .photo { position: relative; }
  .photo img { width: 100%; aspect-ratio: 1; object-fit: cover; border-radius: 28px; border: 1px solid var(--line); box-shadow: 0 40px 80px -30px rgba(124,77,255,.55); }
  .tag { position: absolute; left: 18px; bottom: 18px; background: rgba(10,10,11,.8); backdrop-filter: blur(8px); border: 1px solid #2f2f36; border-radius: 999px; padding: 8px 14px; font-size: 14px; font-weight: 600; }
  .tag b { color: #4ade80; margin-right: 4px; }
  h1 { font-size: clamp(48px, 8vw, 96px); margin: 8px 0 20px; }
  .lead { color: #c8c8cf; font-size: 18px; max-width: 560px; margin: 0; }
  .mail { display: inline-flex; gap: 10px; margin-top: 28px; padding: 14px 22px; border-radius: 999px; background: var(--fg); color: var(--bg); font-size: clamp(17px, 2.4vw, 22px); font-weight: 700; text-decoration: none; overflow-wrap: anywhere; }
  .mail:hover { opacity: .9; }
  .links { display: grid; grid-template-columns: repeat(3, 1fr); gap: 10px; max-width: 560px; margin-top: 18px; }
  .links a { display: flex; justify-content: space-between; padding: 14px 18px; border: 1px solid var(--line); border-radius: 14px; background: var(--bg-2); text-decoration: none; font-weight: 600; }
  .links a:hover { border-color: var(--accent); }
  .links span { color: var(--muted); }
  .note { color: var(--muted); font-size: 14px; margin: 18px 0 0; }
  @media (max-width: 800px) {
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .photo { max-width: 360px; }
    .hero { padding-top: 56px; }
  }
  @media (max-width: 480px) { .links { grid-template-columns: 1fr; } }
</style>
